digit [0-9]

%{
#include <stdio.h>
int cons = 0;
%}

%%

{digit}+ {
    cons++;
    printf("%s is a constant\n", yytext);
}

.|\n { }

%%

int yywrap(void)
{
    return 1;
}

int main(void)
{
    FILE *f;
    char file[256];

    printf("Enter File Name: ");
    scanf("%255s", file);

    f = fopen(file, "r");

    if (f == NULL) {
        printf("File cannot be opened\n");
        return 1;
    }

    yyin = f;
    yylex();

    printf("Number of Constants: %d\n", cons);

    fclose(yyin);
    return 0;
}